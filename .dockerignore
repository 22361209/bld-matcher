# Keep the root Markdown history while excluding local non-ASCII business folders.
# Use ASCII patterns only for Synology BuildKit.
[^ -~]*
![^ -~]*.md
.git/*
!.git/HEAD
!.git/refs/
.git/refs/*
!.git/refs/heads/
!.git/refs/heads/**
.DS_Store
.env*
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.playwright-cli/
.venv/
venv/
logs/
uploads/
outputs/
data/
static/product_images/
